# Copie ce fichier en .env et remplis les valeurs (ne jamais commiter .env)

# --- Front (exposées au navigateur, c'est normal) ---
# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# npm run vapid (clé publique)
VITE_VAPID_PUBLIC_KEY=
# Ton email : débloque la page "Mots doux" pour les écrire
VITE_ADMIN_EMAIL=

# --- Serveur uniquement (Netlify > Site configuration > Environment variables) ---
# aistudio.google.com/apikey (offre gratuite)
GEMINI_API_KEY=
# Optionnel : modèle Gemini essayé en premier (sinon gemini-3.5-flash-lite, puis 3.6-flash, puis 3.1-flash-lite)
GEMINI_MODEL=
# Supabase > Project Settings > API (secrète)
SUPABASE_SERVICE_ROLE_KEY=
# npm run vapid (clé privée)
VAPID_PRIVATE_KEY=
# mailto:ton-email
VAPID_SUBJECT=
